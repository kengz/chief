# Git carries the toolkit, not your notes. Default-deny, then name the toolkit.
/*
!/.agents/
!/.claude/
!/.githooks/
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/install.sh
!/records/
!/planner.md
!/projects/
!/projects/example/
!/projects/example/status.md

# Machine-local files and runtime state stay out of git.
.claude/secrets.env
.claude/settings.local.json
.claude/seen-urls.txt
.claude/intel-sources.md
.claude/scheduled_tasks.*
.claude/worktrees/
.claude/projects/
.claude/state/
*.env
