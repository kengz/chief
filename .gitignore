# Git carries the toolkit, not your notes. Default-deny, then name the toolkit.
/*
!/.agents/
!/.claude/
!/.githooks/
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/install.sh
!/records/
!/planner.md
!/projects/
!/projects/example/
!/projects/example/status.md

# Box-local files and runtime state stay out of git. .agents/local/ holds what is about your own work, not procedure:
# the intel feed list, the seen-URL list and secrets. Examples ship beside the files that read them.
.agents/local/
.claude/settings.local.json
.claude/scheduled_tasks.*
.claude/worktrees/
.claude/projects/
.claude/state/
*.env
